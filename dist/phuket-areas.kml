<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>Phuket trip · Jan 2027</name><Style id="a-patong"><LineStyle><color>ff5F43D9</color><width>2</width></LineStyle><PolyStyle><color>665F43D9</color></PolyStyle></Style><Style id="a-kamala"><LineStyle><color>ffD16F8C</color><width>2</width></LineStyle><PolyStyle><color>66D16F8C</color></PolyStyle></Style><Style id="a-surin"><LineStyle><color>ff795DD4</color><width>2</width></LineStyle><PolyStyle><color>66795DD4</color></PolyStyle></Style><Style id="a-bang-tao"><LineStyle><color>ffD17F3D</color><width>2</width></LineStyle><PolyStyle><color>66D17F3D</color></PolyStyle></Style><Style id="a-layan"><LineStyle><color>ffD87B9A</color><width>2</width></LineStyle><PolyStyle><color>66D87B9A</color></PolyStyle></Style><Style id="a-nai-thon"><LineStyle><color>ff4F9AE3</color><width>2</width></LineStyle><PolyStyle><color>664F9AE3</color></PolyStyle></Style><Style id="a-nai-yang"><LineStyle><color>ff9A71E0</color><width>2</width></LineStyle><PolyStyle><color>669A71E0</color></PolyStyle></Style><Style id="a-mai-khao"><LineStyle><color>ff7AA33F</color><width>2</width></LineStyle><PolyStyle><color>667AA33F</color></PolyStyle></Style><Style id="a-karon"><LineStyle><color>ff3A96F0</color><width>2</width></LineStyle><PolyStyle><color>663A96F0</color></PolyStyle></Style><Style id="a-kata"><LineStyle><color>ff9AB52F</color><width>2</width></LineStyle><PolyStyle><color>669AB52F</color></PolyStyle></Style><Style id="a-kata-noi"><LineStyle><color>ffD66B7E</color><width>2</width></LineStyle><PolyStyle><color>66D66B7E</color></PolyStyle></Style><Style id="a-nai-harn"><LineStyle><color>ff41A5F2</color><width>2</width></LineStyle><PolyStyle><color>6641A5F2</color></PolyStyle></Style><Style id="a-rawai"><LineStyle><color>ffB07BE0</color><width>2</width></LineStyle><PolyStyle><color>66B07BE0</color></PolyStyle></Style><Style id="a-chalong"><LineStyle><color>ffD19F3B</color><width>2</width></LineStyle><PolyStyle><color>66D19F3B</color></PolyStyle></Style><Style id="a-phuket-town"><LineStyle><color>ff3DA3E8</color><width>2</width></LineStyle><PolyStyle><color>663DA3E8</color></PolyStyle></Style><Style id="a-kathu"><LineStyle><color>ff3DA86F</color><width>2</width></LineStyle><PolyStyle><color>663DA86F</color></PolyStyle></Style><Style id="a-cape-panwa"><LineStyle><color>ff45BF9B</color><width>2</width></LineStyle><PolyStyle><color>6645BF9B</color></PolyStyle></Style><Style id="a-ao-po"><LineStyle><color>ffD68F5C</color><width>2</width></LineStyle><PolyStyle><color>66D68F5C</color></PolyStyle></Style><Style id="a-thalang"><LineStyle><color>ff9AA79A</color><width>2</width></LineStyle><PolyStyle><color>669AA79A</color></PolyStyle></Style><Style id="a-natai"><LineStyle><color>ff8F9C2E</color><width>2</width></LineStyle><PolyStyle><color>668F9C2E</color></PolyStyle></Style><Style id="p-event"><IconStyle><color>ff935fff</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="p-place"><IconStyle><color>ff80740a</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="p-gem"><IconStyle><color>ff5f28c4</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="p-hotel"><IconStyle><color>ffc6555a</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style><Style id="p-money"><IconStyle><color>ff1484c9</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Folder><name>Areas</name><Placemark><name>Patong &amp; Kalim</name><description><![CDATA[<b>Party town, with real techno in Shelter at Illuzion</b><br>Phuket's busiest and loudest area. Bangla Road closes to cars from 18:00 and fills with bars, go-go bars and big clubs. Illuzion is number 9 in DJ Mag's Top 100 Clubs 2026; its Shelter room plays techno and minimal. Hotels for every budget and street food. Kalim, just north, is a quieter rocky bay with good restaurants.<br><br>Stay here if you want to walk to Shelter and Illuzion and do not mind noise; sleep at the north end or in Kalim.]]></description><styleUrl>#a-patong</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.26092,7.8857,0 98.26149,7.88561,0 98.26392,7.88359,0 98.26445,7.88248,0 98.26437,7.8808,0 98.26488,7.88033,0 98.26562,7.88016,0 98.27086,7.88265,0 98.27131,7.8825,0 98.27216,7.88196,0 98.27174,7.88015,0 98.27264,7.87786,0 98.2769,7.87579,0 98.28002,7.87539,0 98.28366,7.87589,0 98.2855,7.87322,0 98.28585,7.87166,0 98.28669,7.87093,0 98.28876,7.87046,0 98.29611,7.87105,0 98.2972,7.87078,0 98.29937,7.86922,0 98.30159,7.8686,0 98.30334,7.86894,0 98.30684,7.87111,0 98.31038,7.87398,0 98.31486,7.87395,0 98.32178,7.89593,0 98.32082,7.90734,0 98.31493,7.92051,0 98.31296,7.93055,0 98.2903,7.93089,0 98.28192,7.92247,0 98.27959,7.92161,0 98.27894,7.92187,0 98.27882,7.92092,0 98.27959,7.9196,0 98.28066,7.91935,0 98.28128,7.91771,0 98.28527,7.91567,0 98.28769,7.91662,0 98.28977,7.91686,0 98.29127,7.91606,0 98.2934,7.91376,0 98.29573,7.90966,0 98.29647,7.90919,0 98.29609,7.9075,0 98.29679,7.90711,0 98.29678,7.90604,0 98.29572,7.8981,0 98.29362,7.89226,0 98.28991,7.88674,0 98.28669,7.88545,0 98.28614,7.886,0 98.28649,7.88728,0 98.28252,7.88677,0 98.2807,7.88849,0 98.27889,7.88763,0 98.27819,7.88678,0 98.27504,7.88623,0 98.27245,7.88631,0 98.2717,7.88671,0 98.27186,7.88895,0 98.27097,7.89024,0 98.27019,7.89064,0 98.26736,7.89059,0 98.26662,7.89149,0 98.26603,7.89095,0 98.26502,7.89121,0 98.26465,7.89192,0 98.26516,7.89262,0 98.26421,7.89318,0 98.26348,7.8922,0 98.26414,7.89055,0 98.26254,7.89032,0 98.26228,7.88858,0 98.26092,7.8857,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Kamala</name><description><![CDATA[<b>Calm family beach with Café del Mar at the north end</b><br>A long, wide beach by a Muslim fishing village, calmer and more Thai than Patong. Families, couples and repeat visitors like it. Café del Mar at the quiet north end books big house and techno DJs in season. Apart from Café del Mar, nights are quiet; Phuket FantaSea and Carnival Magic are the big evening shows.<br><br>Stay here if you want a calm beach, Café del Mar on foot, and Shelter and Enthusiast Place within about 20 minutes by car.]]></description><styleUrl>#a-kamala</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.25806,7.93506,0 98.25905,7.93461,0 98.26029,7.93509,0 98.26129,7.93474,0 98.26108,7.93323,0 98.26215,7.93111,0 98.2613,7.92987,0 98.2608,7.92759,0 98.26219,7.92719,0 98.26211,7.9256,0 98.26276,7.92495,0 98.263,7.92388,0 98.26212,7.92344,0 98.26424,7.92403,0 98.26514,7.92521,0 98.26607,7.92572,0 98.26782,7.92514,0 98.26903,7.92275,0 98.27074,7.92341,0 98.27056,7.92475,0 98.27164,7.92555,0 98.27572,7.92426,0 98.27613,7.92366,0 98.2759,7.92309,0 98.277,7.92176,0 98.27845,7.92207,0 98.27959,7.92161,0 98.28192,7.92247,0 98.2903,7.93089,0 98.31296,7.93055,0 98.31255,7.93498,0 98.31308,7.94263,0 98.31823,7.94926,0 98.31617,7.94999,0 98.31564,7.95084,0 98.31549,7.95311,0 98.31392,7.95662,0 98.3118,7.9592,0 98.30661,7.96347,0 98.30196,7.96515,0 98.29729,7.96601,0 98.29217,7.96775,0 98.28776,7.97009,0 98.2867,7.9703,0 98.28373,7.96973,0 98.2826,7.96989,0 98.28135,7.96936,0 98.28031,7.97012,0 98.27829,7.97052,0 98.27845,7.9695,0 98.27892,7.96946,0 98.27945,7.96815,0 98.2793,7.96725,0 98.2785,7.96676,0 98.27899,7.96648,0 98.27876,7.96585,0 98.27931,7.96548,0 98.27944,7.96389,0 98.28068,7.96321,0 98.28214,7.96365,0 98.28314,7.96261,0 98.28333,7.96183,0 98.28337,7.95919,0 98.28251,7.95483,0 98.2813,7.95172,0 98.2806,7.95087,0 98.27712,7.94931,0 98.27719,7.94893,0 98.27673,7.94915,0 98.27665,7.9503,0 98.27525,7.94996,0 98.27387,7.95029,0 98.27292,7.9498,0 98.2726,7.94877,0 98.26841,7.94679,0 98.26744,7.94671,0 98.2661,7.94766,0 98.26412,7.94753,0 98.26418,7.9481,0 98.2631,7.94902,0 98.26236,7.94855,0 98.26197,7.94605,0 98.26244,7.94404,0 98.26081,7.94241,0 98.25806,7.93506,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Surin &amp; Pansea</name><description><![CDATA[<b>One of Phuket's best beaches, now with nothing on the sand</b><br>An 800 m bay of soft pale sand between Kamala and Bang Tao, with casuarina trees behind it. All food stalls, sunbeds and massages were removed in May 2025, so it looks natural again. Tukta, on the rocks at the south end, is one of only two places still serving food. Twinpalms, The Surin and Amanpuri are close.<br><br>Stay here if you want a quiet luxury hotel on a beautiful beach and will take taxis for food and parties.]]></description><styleUrl>#a-surin</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.27008,7.98617,0 98.27179,7.98602,0 98.27266,7.98526,0 98.27206,7.98384,0 98.27401,7.98426,0 98.27536,7.9839,0 98.27646,7.98245,0 98.27691,7.98065,0 98.27619,7.97967,0 98.27757,7.97899,0 98.27847,7.97247,0 98.27826,7.97188,0 98.2764,7.97029,0 98.27692,7.96949,0 98.27845,7.9695,0 98.27829,7.97052,0 98.28031,7.97012,0 98.28135,7.96936,0 98.28238,7.96986,0 98.28373,7.96973,0 98.2867,7.9703,0 98.28776,7.97009,0 98.29217,7.96775,0 98.29729,7.96601,0 98.30196,7.96515,0 98.30661,7.96347,0 98.30875,7.96174,0 98.31033,7.96342,0 98.31158,7.96702,0 98.31179,7.96917,0 98.31303,7.97363,0 98.3126,7.97496,0 98.31268,7.97637,0 98.29693,7.98477,0 98.29658,7.98529,0 98.28883,7.989,0 98.28776,7.98727,0 98.28589,7.98556,0 98.28416,7.9848,0 98.27829,7.9856,0 98.27756,7.98611,0 98.27777,7.9869,0 98.27723,7.98724,0 98.27494,7.98666,0 98.27364,7.98774,0 98.27332,7.98868,0 98.27251,7.98862,0 98.27158,7.98923,0 98.27019,7.98796,0 98.27008,7.98617,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Bang Tao, Laguna &amp; Cherngtalay</name><description><![CDATA[<b>Long beach, top restaurants and beach clubs</b><br>A 6 km beach with the Laguna resort complex in the middle and Cherngtalay town behind it. The upmarket side of Phuket: villas, Michelin-listed restaurants and Boat Avenue's shops and bars. Catch and Xana are the big beach clubs. Traffic is often bad.<br><br>Stay here if you want great food and beach clubs nearby and a 30-minute ride to the airport, and do not need a party street.]]></description><styleUrl>#a-bang-tao</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.28883,7.989,0 98.29658,7.98529,0 98.29693,7.98477,0 98.31268,7.97637,0 98.31285,7.9793,0 98.31622,7.99077,0 98.31628,7.99214,0 98.3168,7.99311,0 98.32059,7.99448,0 98.31997,7.99558,0 98.32072,7.99755,0 98.32321,7.99961,0 98.32388,8.00116,0 98.32423,8.00422,0 98.32381,8.00611,0 98.32159,8.00739,0 98.32119,8.00889,0 98.31972,8.00956,0 98.31986,8.01046,0 98.31884,8.01215,0 98.31831,8.01672,0 98.31633,8.02184,0 98.31372,8.02149,0 98.31351,8.02179,0 98.30552,8.01837,0 98.30357,8.01916,0 98.29097,8.01829,0 98.2925,8.00531,0 98.29226,8.00141,0 98.29143,7.99638,0 98.28996,7.99136,0 98.28883,7.989,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Layan</name><description><![CDATA[<b>Quiet north end of Bang Tao with an island and a river</b><br>The quiet north end of Bang Tao Bay, inside Sirinat National Park. The beach ends at a river mouth with a big wooded island in front. The small restaurants under the trees were removed; only Tan Restaurant & Massage is left. Anantara Layan and other luxury villas sit just north of the river. Very quiet at night.<br><br>Stay here if you want a peaceful villa or resort near the airport and Bang Tao, and will take taxis for nights out.]]></description><styleUrl>#a-layan</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.27208,8.03794,0 98.27231,8.03811,0 98.27237,8.03746,0 98.27475,8.0368,0 98.27589,8.03358,0 98.27712,8.03391,0 98.27821,8.03343,0 98.28024,8.03358,0 98.28107,8.03512,0 98.28308,8.03567,0 98.28378,8.03531,0 98.2851,8.03337,0 98.28482,8.03401,0 98.28586,8.03484,0 98.28524,8.03418,0 98.28475,8.03214,0 98.28409,8.03157,0 98.28699,8.03052,0 98.28848,8.02884,0 98.28948,8.02587,0 98.29097,8.01829,0 98.30357,8.01916,0 98.30552,8.01837,0 98.31351,8.02179,0 98.31304,8.02249,0 98.31303,8.02522,0 98.3101,8.02927,0 98.31315,8.0429,0 98.3122,8.04452,0 98.30932,8.04587,0 98.30435,8.04647,0 98.29831,8.04564,0 98.29395,8.04591,0 98.28344,8.04782,0 98.27743,8.04757,0 98.27742,8.04607,0 98.27643,8.04476,0 98.27656,8.04228,0 98.27573,8.04123,0 98.27394,8.04116,0 98.27342,8.04018,0 98.27208,8.04007,0 98.27208,8.03794,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Nai Thon</name><description><![CDATA[<b>Quiet bay under green hills, 15 minutes from the airport</b><br>A small curved bay below steep hills, inside Sirinat National Park. There is no real town, just a few hotels, guesthouses and simple Thai restaurants along the beach. Quiet day and night. Banana Beach, 2 km south, changed in late 2025: the old jungle path closed, and a car park (100 THB, ≈1,100 AMD) and a big beach club opened.<br><br>Stay here if you want a quiet beach close to the airport for your first or last nights.]]></description><styleUrl>#a-nai-thon</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.27039,8.07141,0 98.27093,8.07061,0 98.27075,8.0702,0 98.27177,8.06668,0 98.27396,8.06416,0 98.27544,8.0635,0 98.27575,8.06263,0 98.27657,8.06264,0 98.27733,8.05859,0 98.27755,8.05388,0 98.27738,8.05321,0 98.27654,8.05265,0 98.27606,8.05121,0 98.2769,8.05002,0 98.27743,8.04757,0 98.28344,8.04782,0 98.29395,8.04591,0 98.29831,8.04564,0 98.30435,8.04647,0 98.31132,8.05233,0 98.31186,8.05353,0 98.31188,8.05506,0 98.31091,8.05817,0 98.31213,8.05889,0 98.31274,8.06088,0 98.31484,8.07288,0 98.2803,8.07687,0 98.27621,8.0793,0 98.27559,8.07854,0 98.2747,8.07895,0 98.27319,8.0787,0 98.2723,8.07804,0 98.27077,8.0748,0 98.27079,8.0719,0 98.27039,8.07141,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Nai Yang</name><description><![CDATA[<b>Beach restaurants and planes, 10 minutes from the airport</b><br>A relaxed beach village next to the airport, inside Sirinat National Park. Casuarina trees give shade, and simple restaurants put tables on the sand. It has an old-Phuket feel. There is a coral reef off the beach, and the plane-spotting spot at the end of the runway is close. Nightlife is a few small bars.<br><br>Stay here if you have an early flight or want simple beach food and a local feel near the airport.]]></description><styleUrl>#a-nai-yang</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.27621,8.0793,0 98.2803,8.07687,0 98.31484,8.07288,0 98.31538,8.07597,0 98.331,8.09056,0 98.33084,8.09789,0 98.32891,8.10189,0 98.32615,8.10491,0 98.32443,8.10765,0 98.32342,8.10826,0 98.31831,8.10386,0 98.31048,8.1059,0 98.30971,8.10199,0 98.30076,8.1045,0 98.29952,8.10224,0 98.29675,8.09955,0 98.2982,8.09506,0 98.29824,8.09348,0 98.29774,8.09049,0 98.29609,8.08777,0 98.29351,8.08622,0 98.29051,8.08329,0 98.28925,8.083,0 98.28824,8.08323,0 98.28733,8.08417,0 98.28723,8.08502,0 98.28628,8.08525,0 98.28427,8.08431,0 98.28287,8.08258,0 98.28119,8.08223,0 98.28005,8.081,0 98.27868,8.08088,0 98.27677,8.07996,0 98.27621,8.0793,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Mai Khao</name><description><![CDATA[<b>11 km of empty sand, big resorts and landing planes</b><br>Phuket's longest beach, 11 km, inside Sirinat National Park. No chairs, vendors or jet skis, just a few big resorts set back from the sand, such as Sala, Renaissance, JW Marriott and Anantara. Sea turtles sometimes nest here from November to February. Patong is an hour away, and there is nothing to walk to at night.<br><br>Stay here if you want a big resort on an empty beach close to the airport and do not plan many nights out.]]></description><styleUrl>#a-mai-khao</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.28362,8.19683,0 98.2851,8.19457,0 98.28768,8.18836,0 98.29028,8.17882,0 98.29623,8.1516,0 98.29774,8.1397,0 98.30148,8.11907,0 98.30171,8.11061,0 98.30076,8.1045,0 98.30971,8.10199,0 98.31048,8.1059,0 98.31831,8.10386,0 98.32342,8.10826,0 98.32443,8.10765,0 98.32615,8.10491,0 98.32891,8.10189,0 98.33084,8.09789,0 98.331,8.09056,0 98.33574,8.09139,0 98.34125,8.09558,0 98.3422,8.09668,0 98.34365,8.09656,0 98.34653,8.09809,0 98.34784,8.09792,0 98.34835,8.10108,0 98.34753,8.1034,0 98.34882,8.10516,0 98.34874,8.10604,0 98.35155,8.11094,0 98.35107,8.11154,0 98.35197,8.114,0 98.35047,8.11451,0 98.35111,8.11526,0 98.35228,8.11506,0 98.35238,8.11541,0 98.35082,8.11574,0 98.35095,8.11629,0 98.35257,8.11605,0 98.35277,8.11711,0 98.35368,8.1174,0 98.35413,8.11813,0 98.3527,8.11853,0 98.35248,8.11973,0 98.35298,8.12059,0 98.35405,8.12129,0 98.35418,8.12406,0 98.35321,8.12543,0 98.35097,8.12557,0 98.35017,8.12516,0 98.34735,8.1221,0 98.34735,8.11994,0 98.34627,8.11773,0 98.34611,8.11548,0 98.34566,8.11569,0 98.34665,8.1223,0 98.3453,8.12772,0 98.34516,8.13397,0 98.34423,8.13405,0 98.3444,8.13455,0 98.3454,8.13443,0 98.34525,8.13554,0 98.34803,8.13632,0 98.34735,8.13681,0 98.34786,8.13982,0 98.34755,8.14344,0 98.34714,8.14339,0 98.34662,8.14443,0 98.34367,8.14446,0 98.34224,8.14522,0 98.34114,8.14939,0 98.34066,8.15359,0 98.34137,8.15759,0 98.3412,8.15909,0 98.34046,8.16194,0 98.3396,8.16219,0 98.33926,8.16332,0 98.33927,8.16849,0 98.33778,8.17133,0 98.33664,8.17288,0 98.33416,8.17222,0 98.33236,8.17262,0 98.33052,8.17387,0 98.32955,8.17506,0 98.32756,8.17551,0 98.32283,8.17817,0 98.32055,8.18033,0 98.32008,8.18106,0 98.3199,8.18262,0 98.31853,8.18309,0 98.31538,8.186,0 98.31302,8.18691,0 98.31228,8.18672,0 98.31216,8.18565,0 98.31112,8.18448,0 98.31017,8.18393,0 98.30908,8.18454,0 98.30993,8.18648,0 98.30964,8.18715,0 98.30919,8.18663,0 98.30836,8.18719,0 98.30868,8.18866,0 98.30466,8.19282,0 98.30283,8.19089,0 98.29706,8.1889,0 98.29763,8.18964,0 98.30248,8.19195,0 98.30344,8.19341,0 98.30029,8.19123,0 98.2995,8.19152,0 98.29988,8.19274,0 98.30136,8.19414,0 98.302,8.19732,0 98.30055,8.19848,0 98.2972,8.19919,0 98.29747,8.2004,0 98.29595,8.19908,0 98.29504,8.19894,0 98.29367,8.19917,0 98.29322,8.19996,0 98.29235,8.20031,0 98.2889,8.19956,0 98.28635,8.20001,0 98.28545,8.19971,0 98.28362,8.19683,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Karon</name><description><![CDATA[<b>Big, open beach with a relaxed small town</b><br>A wide 3 km beach with a road and promenade behind it, so it never feels crowded. Most hotels are across the road, and the small town has beer bars, live music and good-value restaurants. Families and repeat visitors like it. The dry sand squeaks under your feet. Patong is about 15 minutes north and Kata is next door.<br><br>Stay here if you want a big, calm beach and good value, with Patong's clubs about 15 minutes away.]]></description><styleUrl>#a-karon</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.27221,7.87005,0 98.2733,7.86989,0 98.27296,7.86856,0 98.27338,7.86782,0 98.27466,7.86739,0 98.27662,7.86427,0 98.27903,7.86478,0 98.2809,7.86575,0 98.28217,7.86511,0 98.28332,7.86343,0 98.28255,7.86195,0 98.28248,7.85966,0 98.28429,7.85944,0 98.28604,7.85843,0 98.28908,7.85848,0 98.28946,7.85813,0 98.29264,7.84644,0 98.29435,7.83287,0 98.30067,7.83413,0 98.30945,7.84116,0 98.31593,7.84224,0 98.30684,7.87111,0 98.30334,7.86894,0 98.30159,7.8686,0 98.29937,7.86922,0 98.2972,7.87078,0 98.29611,7.87105,0 98.28876,7.87046,0 98.28669,7.87093,0 98.28585,7.87166,0 98.2855,7.87322,0 98.28366,7.87589,0 98.28002,7.87539,0 98.27558,7.87628,0 98.27562,7.8753,0 98.27511,7.8742,0 98.27353,7.87322,0 98.27356,7.8724,0 98.27406,7.87222,0 98.27381,7.8717,0 98.27335,7.87168,0 98.27337,7.87068,0 98.27221,7.87005,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Kata (Kata Yai)</name><description><![CDATA[<b>Beautiful bay with an island; busy, easy and walkable</b><br>One of Phuket's most beautiful beaches, with soft sand, blue water and Koh Pu, a small island in the bay. It is busy, but nightlife is calm: beer bars, a night market and sunset bars. Club Med fills about 90% of the beachfront, so you reach the sand from the two ends. Many restaurants and hotels, from budget to luxury.<br><br>Stay here if the beach matters most and you want an easy, walkable area with many restaurants.]]></description><styleUrl>#a-kata</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.28964,7.82549,0 98.29031,7.82296,0 98.29161,7.82335,0 98.29273,7.82464,0 98.2957,7.82267,0 98.29759,7.82002,0 98.29876,7.81643,0 98.2988,7.81467,0 98.29826,7.81393,0 98.29692,7.81403,0 98.29581,7.81281,0 98.30953,7.81464,0 98.31573,7.81185,0 98.31622,7.81476,0 98.3172,7.81628,0 98.31769,7.81869,0 98.31938,7.82074,0 98.31922,7.82117,0 98.32086,7.82108,0 98.32314,7.82195,0 98.32498,7.82165,0 98.32523,7.82196,0 98.32488,7.82281,0 98.32722,7.82517,0 98.32581,7.82548,0 98.32532,7.82622,0 98.32131,7.82632,0 98.31773,7.82718,0 98.31737,7.83021,0 98.31436,7.83438,0 98.31415,7.83551,0 98.31588,7.83587,0 98.3164,7.83919,0 98.31593,7.84224,0 98.30945,7.84116,0 98.30067,7.83413,0 98.29435,7.83287,0 98.29412,7.82976,0 98.2904,7.82687,0 98.28964,7.82549,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Kata Noi</name><description><![CDATA[<b>Small, clear bay shared by only three resorts</b><br>An 850 m bay just south of Kata, behind a rocky headland. Only three resorts share it (Katathani, The Shore and Mom Tri's Villa Royale), so it stays calm. There is no town; Kata's restaurants are a short ride away. The hill road above has sunset bars with a view of the bay: After Beach Bar, The Sundeck and Fira.<br><br>Stay here if you want a calm, beautiful swimming beach and sunset bars, and do not need nightlife.]]></description><styleUrl>#a-kata-noi</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.2848,7.7882,0 98.2849,7.78781,0 98.2883,7.78704,0 98.29023,7.78762,0 98.29095,7.78688,0 98.29054,7.78479,0 98.28785,7.78229,0 98.28768,7.78106,0 98.28685,7.77996,0 98.28682,7.77945,0 98.2882,7.77834,0 98.28819,7.77566,0 98.29266,7.77617,0 98.29495,7.77779,0 98.29617,7.77802,0 98.29725,7.77789,0 98.29821,7.77702,0 98.30113,7.77776,0 98.30171,7.77739,0 98.30176,7.77917,0 98.30015,7.78455,0 98.30057,7.79097,0 98.30169,7.79432,0 98.30213,7.79461,0 98.30185,7.79519,0 98.30262,7.79606,0 98.30255,7.79732,0 98.30316,7.79765,0 98.30311,7.79844,0 98.30439,7.80126,0 98.30597,7.80197,0 98.30612,7.80291,0 98.30756,7.8032,0 98.308,7.80448,0 98.30967,7.80519,0 98.30918,7.80589,0 98.30943,7.80678,0 98.31356,7.80915,0 98.31397,7.81074,0 98.31487,7.811,0 98.31573,7.81185,0 98.30953,7.81464,0 98.29581,7.81281,0 98.29559,7.81256,0 98.29609,7.81166,0 98.29584,7.81048,0 98.29814,7.80937,0 98.29859,7.80325,0 98.29719,7.80252,0 98.29726,7.80132,0 98.29565,7.79907,0 98.29542,7.79701,0 98.29415,7.79596,0 98.29379,7.7942,0 98.29219,7.79278,0 98.28949,7.7922,0 98.28643,7.79241,0 98.28482,7.79184,0 98.28535,7.79122,0 98.2848,7.7882,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Nai Harn</name><description><![CDATA[<b>Green hills, a lake and a protected beach in the south</b><br>A wide, soft beach between green hills, with a lake and a temple behind it and yachts in the bay. By law nothing can be built on the land behind the sand, so there are only tall casuarina trees. No town, just scattered restaurants, cafes and villas, with many long-stay expats. Busy in Dec-Jan, but relaxed.<br><br>Stay here if you want nature, a great beach and a calm long-stay feel, and do not mind 30 minutes to Patong.]]></description><styleUrl>#a-nai-harn</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.30015,7.78455,0 98.30176,7.77917,0 98.30186,7.77758,0 98.30333,7.77817,0 98.30455,7.77738,0 98.30671,7.77322,0 98.30654,7.77262,0 98.30534,7.77159,0 98.31315,7.77585,0 98.31572,7.77571,0 98.32204,7.78432,0 98.31301,7.80883,0 98.30943,7.80678,0 98.30918,7.80589,0 98.30967,7.80519,0 98.308,7.80448,0 98.30756,7.8032,0 98.30612,7.80291,0 98.30597,7.80197,0 98.30439,7.80126,0 98.30311,7.79844,0 98.30316,7.79765,0 98.30255,7.79732,0 98.30262,7.79606,0 98.30185,7.79519,0 98.30213,7.79461,0 98.30169,7.79432,0 98.30071,7.79166,0 98.30015,7.78455,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Rawai, Ya Nui &amp; Promthep</name><description><![CDATA[<b>Seafood, island boats and the famous sunset cape</b><br>The working harbour at Phuket's southern tip, not a swimming beach: longtail boats line the shore. People come for the seafood market (buy fish, a restaurant cooks it), boats to Koh Bon, Coral Island and Racha, and a slow local pace with expats, cafes and Muay Thai gyms. Ya Nui and Promthep Cape are a few minutes west.<br><br>Stay here if you want a low-cost long-stay base with seafood, gyms and island boats, and will drive to swim.]]></description><styleUrl>#a-rawai</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.30282,7.75847,0 98.30432,7.75913,0 98.30485,7.76041,0 98.30544,7.76063,0 98.30767,7.7604,0 98.30774,7.75907,0 98.30914,7.75877,0 98.3107,7.75773,0 98.31303,7.7593,0 98.31512,7.75907,0 98.31618,7.76107,0 98.31728,7.76145,0 98.31838,7.7611,0 98.31961,7.76311,0 98.31917,7.76422,0 98.31933,7.76533,0 98.31846,7.76541,0 98.31726,7.76748,0 98.31805,7.76896,0 98.3195,7.77039,0 98.32399,7.77329,0 98.32843,7.77538,0 98.33162,7.77591,0 98.33321,7.77453,0 98.33522,7.77544,0 98.33598,7.77675,0 98.33737,7.77753,0 98.33789,7.77908,0 98.3386,7.77965,0 98.33831,7.78188,0 98.33676,7.78332,0 98.33673,7.78405,0 98.33465,7.78521,0 98.33327,7.78662,0 98.3332,7.7891,0 98.33431,7.79232,0 98.33721,7.79843,0 98.33942,7.80786,0 98.34212,7.8135,0 98.34277,7.81463,0 98.34308,7.81457,0 98.34295,7.81521,0 98.3446,7.82026,0 98.3411,7.82205,0 98.32755,7.82523,0 98.32488,7.82281,0 98.32523,7.82196,0 98.32498,7.82165,0 98.32314,7.82195,0 98.32086,7.82108,0 98.31922,7.82117,0 98.31938,7.82074,0 98.31769,7.81869,0 98.3172,7.81628,0 98.31622,7.81476,0 98.31578,7.81189,0 98.31487,7.811,0 98.31397,7.81074,0 98.31356,7.80915,0 98.31301,7.80883,0 98.32204,7.78432,0 98.31572,7.77571,0 98.31315,7.77585,0 98.30505,7.77126,0 98.30535,7.76899,0 98.30623,7.76825,0 98.30591,7.76754,0 98.30521,7.76718,0 98.30602,7.76689,0 98.30405,7.76406,0 98.3039,7.75977,0 98.30319,7.75947,0 98.30282,7.75847,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Chalong &amp; Soi Ta-iad</name><description><![CDATA[<b>Fitness street, big temples and the island-boat pier</b><br>A local area on Chalong Bay, but with no swimming beach. Soi Ta-iad is Phuket's 'fitness street': 1.5 km of Muay Thai and MMA camps (Tiger Muay Thai since 2003), gyms, healthy cafes and long-stay rooms. Wat Chalong and the Big Buddha are close, and many island trips leave from Chalong Pier. You need a scooter or Grab.<br><br>Stay here if you come to train, want long-stay prices and do not need a beach at your door.]]></description><styleUrl>#a-chalong</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.30684,7.87111,0 98.31582,7.84295,0 98.3164,7.83919,0 98.31588,7.83587,0 98.31415,7.83551,0 98.31436,7.83438,0 98.31737,7.83021,0 98.31773,7.82718,0 98.32131,7.82632,0 98.32532,7.82622,0 98.32581,7.82548,0 98.3411,7.82205,0 98.3446,7.82026,0 98.34621,7.8248,0 98.3489,7.82782,0 98.35154,7.82948,0 98.35205,7.83038,0 98.35636,7.83236,0 98.35866,7.83216,0 98.36037,7.83269,0 98.36366,7.83647,0 98.36473,7.83842,0 98.36745,7.83944,0 98.37489,7.83924,0 98.37534,7.83951,0 98.37565,7.8427,0 98.3751,7.84361,0 98.37316,7.844,0 98.37167,7.84513,0 98.37109,7.84787,0 98.37041,7.84821,0 98.36916,7.8476,0 98.36632,7.84768,0 98.36592,7.84828,0 98.36715,7.85016,0 98.36577,7.85167,0 98.36511,7.85138,0 98.36559,7.84996,0 98.36342,7.85083,0 98.36148,7.85105,0 98.35931,7.85369,0 98.35486,7.85458,0 98.35355,7.85617,0 98.35331,7.8581,0 98.35507,7.86013,0 98.34863,7.865,0 98.34467,7.86369,0 98.33992,7.86476,0 98.34029,7.86671,0 98.33989,7.8694,0 98.34011,7.87107,0 98.34161,7.87443,0 98.33647,7.87603,0 98.33162,7.87263,0 98.33038,7.87091,0 98.32856,7.87025,0 98.32174,7.87216,0 98.3191,7.87201,0 98.31632,7.87353,0 98.31188,7.8742,0 98.31038,7.87398,0 98.30684,7.87111,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark><Placemark><name>Phuket Town (Old Town)</name><description><![CDATA[<b>Old shophouses, the best food and real local life</b><br>Phuket's capital, a great half-day trip. The Old Town has restored Sino-Portuguese shophouses, Chinese shrines, street art, cafes and some of the best food on the island. Hotels are cheap. Bars are small and relaxed; Courage Bar hosted underground nights in Dec 2025-Feb 2026. The coast is 20-30 minutes away.<br><br>Stay here if you love food, culture and low prices, and are happy to ride 30 minutes to the beach and the big clubs.]]></description><styleUrl>#a-phuket-town</styleUrl><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>98.33989,7.8694,0 98.34029,7.86671,0 98.33992,7.86476,0 98.34467,7.86369,0 98.34863,7.865,0 98.35507,7.86013,0 98.35331,7.8581,0 98.35355,7.8561